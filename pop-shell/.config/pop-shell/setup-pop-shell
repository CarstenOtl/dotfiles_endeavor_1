#!/usr/bin/env bash
# Bootstrap Pop Shell + the keyboard/window-manager config that goes with it,
# on a fresh Ubuntu GNOME install. Safe to re-run.
#
# See docs/pop-shell-setup.md in the dotfiles repo for background on each step.
set -euo pipefail

if [ "${XDG_CURRENT_DESKTOP:-}" != "ubuntu:GNOME" ] && [ "${XDG_CURRENT_DESKTOP:-}" != "GNOME" ]; then
    echo "Warning: XDG_CURRENT_DESKTOP=${XDG_CURRENT_DESKTOP:-unset} -- this doesn't look like GNOME. Pop Shell requires GNOME Shell." >&2
fi

if ! gnome-extensions list >/dev/null 2>&1 | grep -q "pop-shell@system76.com"; then
    echo "== Installing Pop Shell build dependencies =="
    sudo apt update
    sudo apt install -y git make nodejs npm gnome-shell-extensions

    echo "== Cloning and building Pop Shell from source =="
    workdir="$(mktemp -d)"
    git clone https://github.com/pop-os/shell.git "$workdir/pop-shell"
    (cd "$workdir/pop-shell" && make local-install)
    rm -rf "$workdir"
else
    echo "== Pop Shell already installed, skipping build =="
fi

echo "== Enabling Pop Shell =="
gnome-extensions enable pop-shell@system76.com

echo "== Disabling extensions that conflict with Pop Shell's tiling/keybindings =="
gnome-extensions disable tiling-assistant@ubuntu.com 2>/dev/null || true
gnome-extensions disable ding@rastersoft.com 2>/dev/null || true

echo "== Window manager / workspace settings =="
gsettings set org.gnome.mutter dynamic-workspaces false
gsettings set org.gnome.desktop.wm.preferences num-workspaces 8
gsettings set org.gnome.mutter center-new-windows true

echo "== Workspace switch/move keybindings (Super+1..8 / Super+Shift+1..8) =="
for i in 1 2 3 4 5 6 7 8; do
    gsettings set org.gnome.desktop.wm.keybindings switch-to-workspace-$i "['<Super>$i']"
    gsettings set org.gnome.desktop.wm.keybindings move-to-workspace-$i "['<Super><Shift>$i']"
done

echo "== Disabling Ubuntu Dock's Super+number app-hotkeys (conflicts with workspace keys above) =="
gsettings set org.gnome.shell.extensions.dash-to-dock hot-keys false 2>/dev/null || true

echo "== Disabling GNOME's native window-tiling/workspace-jump keybindings (Pop Shell owns these keys now) =="
gsettings set org.gnome.mutter.keybindings toggle-tiled-left "[]"
gsettings set org.gnome.mutter.keybindings toggle-tiled-right "[]"
gsettings set org.gnome.desktop.wm.keybindings switch-to-workspace-last "[]"
gsettings set org.gnome.desktop.wm.keybindings move-to-workspace-last "[]"
gsettings set org.gnome.desktop.wm.keybindings switch-to-workspace-left "[]"
gsettings set org.gnome.desktop.wm.keybindings switch-to-workspace-right "[]"
gsettings set org.gnome.shell.keybindings toggle-quick-settings "[]"

echo "== Freeing Super+Space from the input-source switcher (rofi wants it) =="
gsettings set org.gnome.desktop.wm.keybindings switch-input-source "['XF86Keyboard']"
gsettings set org.gnome.desktop.wm.keybindings switch-input-source-backward "['<Shift>XF86Keyboard']"

echo "== Registering input sources for the rofi language switcher (bin/scripts/input-lang-*) =="
gsettings set org.gnome.desktop.input-sources sources \
    "[('xkb', 'us'), ('xkb', 'de'), ('ibus', 'libpinyin')]"

echo "== Custom launcher keybindings (kitty, rofi drun, rofi quicklinks, rofi global file search, rofi input language picker) =="
gsettings set org.gnome.settings-daemon.plugins.media-keys custom-keybindings \
    "['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom1/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom2/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom3/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom4/']"

gsettings set org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0/ name 'Launch kitty'
gsettings set org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0/ command 'kitty'
gsettings set org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0/ binding '<Super>Return'

gsettings set org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom1/ name 'Launch rofi (drun)'
gsettings set org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom1/ command 'bash -c "PATH=$HOME/bin/scripts:$PATH exec rofi -show drun -theme ~/.config/rofi/launchers/type-2/style-3.rasi -normal-window"'
gsettings set org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom1/ binding '<Super>space'

gsettings set org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom2/ name 'Rofi quicklinks'
gsettings set org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom2/ command "$HOME/.config/rofi/applets/bin/quicklinks.sh"
gsettings set org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom2/ binding '<Super><Shift>space'

gsettings set org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom3/ name 'Rofi global file search'
gsettings set org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom3/ command 'rofi -show find -modi "find:~/.config/rofi/scripts/rofi-find.sh" -theme ~/.config/rofi/launchers/type-2/style-3.rasi -normal-window'
gsettings set org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom3/ binding '<Super><Shift>f'

gsettings set org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom4/ name 'Rofi input language picker'
gsettings set org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom4/ command "$HOME/.config/rofi/applets/bin/input-lang.sh"
gsettings set org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom4/ binding '<Primary><Super>l'

echo
echo "Done. Now, from the dotfiles repo root, run:"
echo "  stow pop-shell rofi kitty bin"
echo "to symlink the Pop Shell floating-exceptions config, rofi config, kitty config, and"
echo "~/bin/scripts (input-lang-en/de/zh, etc.) into place."
echo "Then log out and back in for the extension changes to fully apply."
